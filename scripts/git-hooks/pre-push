#!/bin/sh
# Refuse a push whose provenance or destination cannot be established, and refuse one carrying a
# credential.
#
# The commit gate only ever sees what one machine staged. This is the last point before bytes leave
# the tree, so it scans EVERY TRACKED FILE rather than a diff: a secret that arrived before the
# hooks existed is still a secret, and history is what a clone gets.
#
# The destination check asks GitHub, at push time, where these bytes are actually going.
#
# It used to require the destination be PRIVATE, because this repository was private by design.
# That is no longer true: weir is public as of 2026-09-07, deliberately, so the network's SDK, MCP
# server and contract can be read and built on. A guard whose premise is false is worse than no
# guard — every push fails, `--no-verify` becomes habit, and the habit takes the SECRET SCAN below
# with it. The scan is the half that was always doing the work.
#
# So the question changed rather than the strictness. It is no longer "is this private" but "is
# this the repository I mean" — a push to an unexpected remote is the thing worth refusing, and it
# still fails closed on anything other than a definite yes.
#
# Before the change: every tracked file was scanned for a real bech32 `suiprivkey1...`, and every
# one of 684 commits of history, because a clone gets history. Neither holds one.
# `packages/daemon/.env.example` names the variable and has never carried its value.
set -e
refs="$(cat)"
root="$(git rev-parse --show-toplevel)"

if [ "$GIT_PUSH_ANYWAY" != "1" ]; then
  if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
    printf '\n  PUSH REFUSED — this is a linked worktree, not the main checkout\n\n' >&2
    exit 1
  fi
  branch="$(git symbolic-ref --short -q HEAD)" || branch=""
  if [ -z "$branch" ]; then
    printf '\n  PUSH REFUSED — HEAD is detached; commits here belong to no branch\n\n' >&2
    exit 1
  fi
  # Force-pushes only. Git already refuses a non-fast-forward; this catches the --force that
  # overrules it, which is the only thing here that destroys somebody else's commits for good.
  printf '%s\n' "$refs" | while read -r _l local_sha _r remote_sha; do
    [ -z "$local_sha" ] && continue
    case "$remote_sha" in
      *[!0]*) git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null || exit 9 ;;
    esac
  done
  if [ $? -eq 9 ]; then
    printf '\n  PUSH REFUSED — this would rewrite history already on the remote\n\n' >&2
    exit 1
  fi
fi

# Is the destination actually private, right now?
remote_url="$2"
repo_path="$(printf '%s' "$remote_url" | sed -e 's#^git@github.com:#github.com/#' -e 's#^https://github.com/#github.com/#' -e 's#\.git$##')"
case "$repo_path" in
  github.com/*)
    name="${repo_path#github.com/}"
    # The one repository these bytes belong to. A push anywhere else is a mistake or a mistake
    # being made for someone, and either way it is not this.
    if [ "$name" != "Northlatch-Labs-LLC/weir" ]; then
      printf '\n  PUSH REFUSED — destination is %s, not Northlatch-Labs-LLC/weir\n\n' "$name" >&2
      printf '  This is the public home of the network. A push to any other repository is\n' >&2
      printf '  refused here rather than discovered later.\n\n' >&2
      exit 1
    fi
    # It must still exist and be reachable as that name; "unknown" is not a yes.
    seen="$(gh repo view "$name" --json name -q .name 2>/dev/null || echo unknown)"
    if [ "$seen" = "unknown" ]; then
      printf '\n  PUSH REFUSED — GitHub could not confirm %s exists\n\n' "$name" >&2
      printf '  Anything other than a definite yes fails closed.\n\n' >&2
      exit 1
    fi ;;
  *)
    printf '\n  PUSH REFUSED — not a github.com remote, so visibility cannot be checked\n\n' >&2
    exit 1 ;;
esac

# The gate. A push is a claim that this passes; run it rather than assume it.
#
# Typecheck, tests and the Move suite are NOT run here. .github/workflows/ci.yml already runs all
# three on every push, on a machine that has never seen this project — which is the point of them,
# and something a local hook cannot reproduce. Running them again here would add minutes to every
# push and buy nothing, and a slow hook is a hook that gets `--no-verify`d, taking the secret scan
# with it. The scan is what cannot wait for CI: by the time CI reports, the bytes have left.

# First: does the scanner still work at all? Pure in-process arithmetic over synthesised values,
# so it costs nothing and reads no file. Silent unless it fails — because a guard that has quietly
# stopped catching things prints exactly the same "CLEAN" as one that is working.
if ! selftest="$(python3 "$root/scripts/scan-secrets.py" --selftest)"; then
  printf '%s\n' "$selftest" >&2
  printf '\n  PUSH REFUSED — the secret scanner failed its own self-test.\n' >&2
  printf '  A CLEAN result from it cannot be trusted until that passes.\n\n' >&2
  exit 1
fi

if ! python3 "$root/scripts/scan-secrets.py" --all; then
  printf '\n  PUSH REFUSED — a tracked file carries a credential.\n' >&2
  printf '  Rotate it at the provider first; removing it from the file is not the fix, because\n' >&2
  printf '  every clone and every commit already made still holds it.\n\n' >&2
  printf '  `git push --no-verify` overrides this, deliberately: the override should be a\n' >&2
  printf '  decision somebody made, not one nobody saw.\n\n' >&2
  exit 1
fi

{
  "name": "projectx-social",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/every-package-is-tested.mjs && pnpm build:libs && pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "build:libs": "pnpm -r --filter @projectx-social/sdk --filter @projectx-social/policy --filter @projectx-social/signer --filter @projectx-social/agent --filter @projectx-social/mcp build",
    "wren:test": "node --test --test-reporter=spec packages/wren/test/*.test.mjs"
  },
  "dependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "error"
    }
  }
}

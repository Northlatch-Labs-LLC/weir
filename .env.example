# ProjectX Social — deployment configuration.
#
# There are no defaults for anything on chain. An unset variable makes the service refuse to start
# and name what is missing; nothing here ever quietly resolves to a deployment nobody chose. On a
# chain that is not a broken page, it is money moved somewhere else.
#
# The mainnet ids below are a RECORD, from sui-contracts/deploy/mainnet.json. They are filled in
# because this is the deployment that exists — check them against that file before trusting them.

POSTGRES_PASSWORD=
WEB_PORT=3000

PROJECTX_SOCIAL_NETWORK=mainnet
PROJECTX_SOCIAL_GRPC_URL=https://fullnode.mainnet.sui.io:443

# The ORIGINAL package. Every struct and event type tag carries this address forever — Move type
# identity is bound to where a struct was first published. Object and event filters use it.
PROJECTX_SOCIAL_PACKAGE_ID=0xc5c833991ed1123d70b1001c0bcdb01ec5728b09f25dfc42a0edaf16005d404d

# The LATEST package, and the only correct target for a moveCall. Sui does not resolve a package id
# to its newest version: calling the original address runs the original bytecode, so key_registry
# (added in v2) is simply not there.
PROJECTX_SOCIAL_LATEST_PACKAGE_ID=0xa7fd154039f77780f808c7262511a9f4a860620d57e17b58e0e2ca010e1d214d

PROJECTX_SOCIAL_PLATFORM_ID=0x3f695b2c32714e2359c4bb9515598d8dd765b216148c5b8fa818073d52b50f36
PROJECTX_SOCIAL_REGISTRY_ID=0x1a3fb4ac25458d7524be064a2b7e1586ccd9ed09c0d5b351621e3b101e1203a0
PROJECTX_SOCIAL_KEY_REGISTRY_ID=0xe5b8456ccee16c1a1a6ddce1c5523418b4df6b5ce08eb14cea9bf6606eceb6d6

# Gas-only. `harvest` takes no capability, so this key can do nothing but spend its own float.
# Leave EMPTY to bring the stack up in --dry-run, which signs nothing and needs no gas.
PROJECTX_DAEMON_SIGNER_SECRET=
PROJECTX_DAEMON_TICK_SECONDS=3600

# ---------------------------------------------------------------------------------------------
# zkLogin — sign in with Google, no wallet and no seed phrase.
#
# ALL FOUR OR NONE. With any of them unset the sign-in panel offers wallets only and says so; that
# is a deliberate absence, not a failure, and the deployment runs normally. Setting some but not
# all is what gets refused, because a half-configured sign-in fails after the user has already
# been sent to Google.
#
# No contract changed for this feature. A zkLogin address is an ordinary Sui address and every
# entry function already accepts one.
# ---------------------------------------------------------------------------------------------

# From your own Google Cloud project: APIs & Services → Credentials → OAuth 2.0 Client ID, type
# "Web application". The client SECRET is not used and must not be set anywhere — this is the
# implicit flow, which has no code to exchange.
PROJECTX_SOCIAL_GOOGLE_CLIENT_ID=

# Must be registered on that same OAuth client as an Authorized redirect URI, character for
# character. Google compares it exactly; a trailing slash is a different URI.
#   local:  http://localhost:3000/auth/callback
PROJECTX_SOCIAL_ZKLOGIN_REDIRECT_URI=

# The ZK proving service. https, or http://localhost for one running on this machine — the JWT
# travels to it, and a JWT in flight over plain HTTP is an identity assertion anyone on the path
# can replay.
#
# ON MAINNET THERE ARE EXACTLY TWO LEGITIMATE OPTIONS, and the Mysten public endpoint is neither:
# it serves devnet and testnet only.
#   1. Self-host. Docker images `prover` and `prover-fe`, plus the Groth16 zkey from the trusted
#      setup ceremony. Expose prover-fe; keep prover internal. Endpoint is /v1.
#   2. Enoki. Mainnet access to the hosted prover requires allowlisting through it.
PROJECTX_SOCIAL_ZKLOGIN_PROVER_URL=

# BACKUP-CRITICAL, AND IT CAN NEVER BE ROTATED. At least 32 bytes of hex.
#
# Every user's salt is HKDF(ikm = this seed, salt = iss || aud, info = sub), so every zkLogin
# address this deployment issues is a function of it. Lose it and every one of those accounts
# becomes unreachable — not drained, unreachable, which for the holder is the same thing. Change
# it and every existing user silently lands on a different, empty address.
#
# Treat it like the UpgradeCap. It does NOT let this deployment spend: moving money needs a live
# Google-signed token plus the user's ephemeral key, and the seed produces neither.
#
# Generate with:  openssl rand -hex 32
PROJECTX_SOCIAL_ZKLOGIN_SEED=


# ---------------------------------------------------------------------------------------------
# Verified creators — the second registration type.
#
# BOTH OR NEITHER. Unset, no badges are shown and nothing errors; verification is an addition.
#
# Reads NameSold events from the ProjectX name registrar. A badge means "bought a .sui name from
# us", proved on chain — NOT "controls that name today". Names expire and transfer, and nothing
# re-checks that. Do not let the UI imply otherwise.
PROJECTX_SOCIAL_NAMES_PACKAGE_ID=0xb219fbdc681e8e39405b809baa7ec36009329ed88871aab2fc9c62b13eefa10b
PROJECTX_SOCIAL_NAMES_REGISTRAR_ID=0x4ef00bfc1cf91274b2e0ffa9b97d2804708f5e1838a5706ca42a851ccf9f5b3a

# Where a name is bought. https only — this deployment hands the link to users, and one served
# over plain HTTP is one an attacker on the path can redirect. The price is NOT set here; it is
# read from the registrar object, because set_fee_usd can change it at any time.
PROJECTX_SOCIAL_NAMES_STOREFRONT_URL=https://suins.protocolx.io

# ---------------------------------------------------------------------------------------------
# Vault denomination and validator suggestion.

# The coin a NEW creator vault is denominated in. UNSET MEANS NO VAULT CAN BE OPENED — there is no
# safe guess for the denomination of somebody's business. Native Circle USDC on Sui mainnet:
PROJECTX_SOCIAL_VAULT_COIN_TYPES=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Optional. Prefilled when a creator opens a support vault; unset means no suggestion is made and
# they supply their own. Commission is NOT shown — it changes at epoch boundaries and the choice is
# permanent, so a figure read once would be stale on a decision that cannot be revisited.
PROJECTX_SOCIAL_SUGGESTED_VALIDATOR=0x00ae78d3e5ba5d6b8de32455474f52811b95617cbad39ebf4f9e2daf67187407
PROJECTX_SOCIAL_SUGGESTED_VALIDATOR_NAME=OKXEarn

# --- Walrus blob storage -------------------------------------------------------------------------
# Media lives on Walrus. Reads are free through any aggregator; writes cost WAL and SUI and go
# through a publisher we run, because Walrus has no public unauthenticated publisher on mainnet and
# says plainly there are no plans for one.

# Reads. A public community aggregator is fine: blobs are public regardless, which is exactly why
# gated media is encrypted before it is stored. No default — a default would route this deployment's
# reads through infrastructure nobody here chose.
PROJECTX_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space

# Writes. Our own publisher. Unset means uploads fail closed and say why; reading still works.
PROJECTX_WALRUS_PUBLISHER_URL=

# Shared with the publisher's --jwt-decode-secret. At least 32 characters, and generated, never
# chosen: this secret alone authorises spending the publisher wallet's SUI and WAL, so anyone who
# recovers it can drain it. Unset means no upload can be authorised at all, which is the correct
# failure — a publisher started WITHOUT --jwt-decode-secret accepts anything from anyone.
#   openssl rand -hex 32
PROJECTX_WALRUS_PUBLISHER_JWT_SECRET=

#   walrus --context mainnet publisher \
#     --bind-address 127.0.0.1:31416 \
#     --sub-wallets-dir ~/.config/walrus/publisher-wallets \
#     --n-clients 1 \
#     --jwt-decode-secret "$PROJECTX_WALRUS_PUBLISHER_JWT_SECRET" \
#     --jwt-verify-upload \
#     --jwt-expiring-sec 60
#
# --jwt-expiring-sec MUST be exactly 60, matching LIFETIME_SECONDS in lib/publisher-token.ts. The
# publisher requires `exp - iat` to EQUAL this value, not to fall under it, and rejects every token
# otherwise with "the expiration in the query does not match the token" — a message that blames the
# query, which has nothing to do with it.
#
# The publisher wallet needs SUI **coin objects**, not just an address balance: the CLI cannot draw
# gas from an address balance and fails with "could not find SUI coins with sufficient balance"
# while `sui client balance` looks perfectly healthy. Materialise one with:
#   sui client ptb --split-coins gas "[2000000000]" --assign c --transfer-objects "[c]" @<address>

# --- Keys the code reads that the sections above do not cover ----------------------------------
# Every one is optional or environment-specific; blank means "off" or "not configured", never a
# default that does something.

# The content store (web) and the daemon's own database. Postgres URLs; no default anywhere.
PROJECTX_DATABASE_URL=
PROJECTX_TEST_DATABASE_URL=
PROJECTX_DAEMON_DATABASE_URL=

# The address that published the package. Read by scripts/verify-site-admin.ts only.
PROJECTX_SOCIAL_PUBLISHER_ADDRESS=

# Absolute origin of the web app, for links that leave the site (e-mails, share cards).
PROJECTX_WEB_URL=

# Set to 1 when Cloudflare fronts the site, so client addresses are read from its header.
PROJECTX_SOCIAL_BEHIND_CLOUDFLARE=

# The SuiNS registration type tag, used to recognise a name object in a wallet.
PROJECTX_SOCIAL_SUINS_REGISTRATION_TYPE=

# zkLogin: the prover's API key, and a switch that hides Google sign-in entirely (previews).
PROJECTX_SOCIAL_ZKLOGIN_PROVER_KEY=
PROJECTX_SOCIAL_ZKLOGIN_DISABLED=

# Gas budget for the daemon's harvest transactions, in MIST. Blank uses the daemon's bound.
PROJECTX_DAEMON_GAS_BUDGET_MIST=

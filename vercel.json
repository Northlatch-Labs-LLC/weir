{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daemon",
      "schedule": "17 * * * *"
    }
  ],
  "installCommand": "npx --yes pnpm@12.3.4 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@12.3.4 -r build"
}

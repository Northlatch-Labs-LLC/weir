# Built-by: @projectx.sui /|\ · Co-authored-by: Kaela <kaela@projectxprotocol.dev>
#
# One beat, in two phases. Root-owned, oneshot, holds no key.
#
# Phase one runs the container, which reads and writes exactly one file: runs/<beat-id>/intent.json.
# Phase two is packages/purse/bin/beat-phase2.ts: it validates that intent, asks the purse over the
# socket, submits what comes back, and writes state/latest.json on every path — signed, refused, no
# intent, or a thrown error.
#
# The unit is root-owned and the `heron` user is not in the docker group and has no sudo: `docker run
# -v /:/host` makes any other restriction cosmetic, so the ability to run the container is kept with
# the timer rather than given to the account the model's workspace belongs to.

[Unit]
Description=Heron — one beat
Documentation=file:///srv/heron/purse/README.md
After=network-online.target docker.service heron-purse.service
Wants=network-online.target
Requires=docker.service heron-purse.service
# Step 10. Referenced here and built there; the unit does not exist yet and systemd treats a missing
# OnFailure target as a failure to start the alert, not a failure of this unit.
OnFailure=heron-alert@%n.service

[Service]
Type=oneshot
# Written out rather than left to the oneshot default. A beat that hangs against an unreachable
# fullnode must end, and it must end before the next timer tick 30 minutes later — otherwise the
# lock in beat.sh refuses the next beat and the dead man fires on a host that is merely stuck.
TimeoutStartSec=600
User=root
Group=root

# The model credential, decrypted for the life of this beat only and mounted into the container from
# $CREDENTIALS_DIRECTORY. Never written to /srv/heron in the clear.
#
# /etc/heron/creds, not /srv/heron/creds. There is ONE sealed-credential directory on this host and
# every unit, --seal, the README and --plan name the same one: the split meant `--seal openrouter`
# wrote where this unit does not look, this unit failed to start at every tick, and the dead man
# reported a live host as dead (Security's B3 on step 6).
LoadCredentialEncrypted=openrouter:/etc/heron/creds/openrouter.cred

ExecStart=/srv/heron/bin/heron-beat

# ProtectSystem=strict mounts the whole hierarchy read-only except /dev, /proc and /sys; the
# ReadWritePaths below are the exceptions carved back out of it. Without a ProtectSystem= at all,
# ReadWritePaths carves an exception out of nothing and the unit ran as root with the filesystem
# writable while the comment above claimed otherwise (Security's A8 on step 6).
ProtectSystem=strict

# Phase one's output (runs/<beat-id>/intent.json and the beat log) and the sink phase two writes.
#
# /run/docker.sock is the third, and it is named rather than hidden: this unit starts the
# container, so it must reach the daemon's socket, and a process that can talk to that socket can
# run `docker run -v /:/host` and undo every other line in this file. That is why the unit is
# root-owned and the `heron` account the model's container runs as has neither sudo nor docker
# group -- the ability to launch the beat lives with the timer, not with the workspace.
ReadWritePaths=/srv/heron/runs /srv/heron/state /run/docker.sock

NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
UMask=0027

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

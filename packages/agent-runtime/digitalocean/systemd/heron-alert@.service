# Built-by: @projectx.sui /|\ · Co-authored-by: Kaela <kaela@projectxprotocol.dev>
#
# A parameterized oneshot: `systemctl start heron-alert@<instance>.service` sends one email naming
# <instance>. Triggered by heron-watchdog.service's OnFailure=heron-alert@watchdog.service, by
# heron-alive.timer's Unit=heron-alert@alive.service, and (build order step 5, not this branch)
# by heron-beat.service's own OnFailure=heron-alert@%n.service on a failed beat.
#
# The credential is loaded ONLY through systemd's own encrypted-credential mechanism -- never an
# environment variable, never a file this unit names directly. LoadCredentialEncrypted decrypts
# the sealed blob (placed by deploy-droplet.sh --seal mail-key, piped straight into
# `systemd-creds encrypt --with-key=host` over the SSH session, never as a plaintext file on this
# disk) into a per-unit tmpfs at $CREDENTIALS_DIRECTORY/mail-key, 0400, gone when the unit stops.
# bin/heron-alert reads that path itself and only in its non-dry-run branch -- see that file.
[Unit]
Description=Send one Heron notice for instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/heron-alert %i
LoadCredentialEncrypted=mail-key:/etc/heron/creds/mail-key.cred
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Built-by: @projectx.sui /|\ · Co-authored-by: Kaela <kaela@projectxprotocol.dev>
#
# Every 15 minutes, per build order step 6 and CTO spec section 3.9. Not enabled by cloud-init --
# deploy-droplet.sh --smoke enables this alongside heron-beat.timer, once one real beat has proven
# the host works.
[Unit]
Description=Run the Heron watchdog every 15 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target

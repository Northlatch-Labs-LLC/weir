#!/usr/bin/env bash
# Built-by: @projectx.sui /|\ · Co-authored-by: Kaela <kaela@projectxprotocol.dev>
#
# The host-side dead-man check (CTO spec 2026-09-05-engineering-heron-v2-runtime-and-host.md
# section 3.11). Refuses (non-zero exit) if state/latest.json is missing or older than the
# 90-minute ceiling; systemd's OnFailure=heron-alert@watchdog.service on the calling unit is what
# turns that refusal into an email -- this script only decides, it never sends anything itself, so
# the decision has one failing fixture independent of whether mail can be sent at all.
#
# HERON_STATE_FILE and HERON_WATCHDOG_MAX_AGE_SECONDS are overridable so test/host.test.mjs can
# run this exact binary against a fixture instead of a real /srv/heron.
set -euo pipefail

STATE_FILE="${HERON_STATE_FILE:-/srv/heron/state/latest.json}"
MAX_AGE_SECONDS="${HERON_WATCHDOG_MAX_AGE_SECONDS:-5400}" # 90 minutes

if [ ! -e "$STATE_FILE" ]; then
  echo "heron-watchdog: refused - $STATE_FILE does not exist; no beat has completed, or the sink was lost" >&2
  exit 1
fi

NOW="$(date +%s)"
# GNU stat (the host) and BSD stat (this laptop, for the test) disagree on flags; try both rather
# than assume which one is running.
MTIME="$(stat -c %Y "$STATE_FILE" 2>/dev/null || stat -f %m "$STATE_FILE")"
AGE=$((NOW - MTIME))

if [ "$AGE" -gt "$MAX_AGE_SECONDS" ]; then
  echo "heron-watchdog: refused - $STATE_FILE is ${AGE}s old, past the ${MAX_AGE_SECONDS}s ceiling" >&2
  exit 1
fi

echo "heron-watchdog: ok - $STATE_FILE is ${AGE}s old (ceiling ${MAX_AGE_SECONDS}s)"
exit 0

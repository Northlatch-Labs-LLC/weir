# ProjectX Social SDK configuration.
#
# There are no defaults. Every variable below must be set explicitly — an unset one makes
# loadConfig() return a failure naming it, rather than quietly resolving to a deployment nobody
# chose. On a chain, a plausible-looking default address is not a failed request; it is money sent
# somewhere unintended.
#
# The values below are the LIVE MAINNET deployment, recorded in sui-contracts/deploy/mainnet.json.
# Copy this file to .env and edit it if you are targeting anything else.

PROJECTX_SOCIAL_NETWORK=mainnet

PROJECTX_SOCIAL_GRPC_URL=https://fullnode.mainnet.sui.io:443

PROJECTX_SOCIAL_PACKAGE_ID=0xc5c833991ed1123d70b1001c0bcdb01ec5728b09f25dfc42a0edaf16005d404d

# The ORIGINAL package above is what every struct and event type tag carries, forever — a Move
# type's identity is bound to the address it was first published at. Object filters and event
# filters must use it.
#
# The LATEST package below is the only correct target for a moveCall. Sui does not resolve a
# package id to its newest version: calling the original address runs the original bytecode, so
# `key_registry` (added in the v2 upgrade) is simply not there.
PROJECTX_SOCIAL_LATEST_PACKAGE_ID=0xa7fd154039f77780f808c7262511a9f4a860620d57e17b58e0e2ca010e1d214d

# The shared key_registry::KeyRegistry, created by the v2 upgrade. Encrypted messaging reads
# published X25519 keys from here; without it that feature refuses to run rather than falling back
# to a server-held registry, which is the thing the upgrade removed.
PROJECTX_SOCIAL_KEY_REGISTRY_ID=0xe5b8456ccee16c1a1a6ddce1c5523418b4df6b5ce08eb14cea9bf6606eceb6d6
PROJECTX_SOCIAL_PLATFORM_ID=0x3f695b2c32714e2359c4bb9515598d8dd765b216148c5b8fa818073d52b50f36
PROJECTX_SOCIAL_REGISTRY_ID=0x1a3fb4ac25458d7524be064a2b7e1586ccd9ed09c0d5b351621e3b101e1203a0

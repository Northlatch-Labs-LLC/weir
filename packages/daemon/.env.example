# ProjectX Social harvest daemon.
#
# No defaults for the three required variables. An unset one names itself and the process exits 1.

PROJECTX_SOCIAL_GRPC_URL=https://fullnode.mainnet.sui.io:443
PROJECTX_SOCIAL_PACKAGE_ID=0xc5c833991ed1123d70b1001c0bcdb01ec5728b09f25dfc42a0edaf16005d404d

# The ORIGINAL package above is what every struct and event type tag carries, forever — a Move
# type's identity is bound to the address it was first published at. Object filters and event
# filters must use it.
#
# The LATEST package below is the only correct target for a moveCall. Sui does not resolve a
# package id to its newest version: calling the original address runs the original bytecode, so
# `key_registry` (added in the v2 upgrade) is simply not there.
PROJECTX_SOCIAL_LATEST_PACKAGE_ID=0xa7fd154039f77780f808c7262511a9f4a860620d57e17b58e0e2ca010e1d214d

# The shared key_registry::KeyRegistry, created by the v2 upgrade. Encrypted messaging reads
# published X25519 keys from here; without it that feature refuses to run rather than falling back
# to a server-held registry, which is the thing the upgrade removed.
PROJECTX_SOCIAL_KEY_REGISTRY_ID=0xe5b8456ccee16c1a1a6ddce1c5523418b4df6b5ce08eb14cea9bf6606eceb6d6

# The harvest signer, bech32 "suiprivkey1...".
#
# ⚠️ USE A DEDICATED, LOW-VALUE KEY. `harvest` is permissionless: it takes no capability and
# confers no authority, so this key needs gas and nothing else. If it leaks, the attacker's entire
# power is to harvest vaults — which is what the daemon does anyway.
#
# Do NOT give this address PlatformCap, StakeCap, or a treasury. Fund it with a small gas float and
# top it up rather than raising the ceiling. Never commit a real value here.
PROJECTX_DAEMON_SIGNER_SECRET=

# Optional. Values shown are what is used when unset.
PROJECTX_DAEMON_TICK_SECONDS=3600
PROJECTX_DAEMON_MAX_DISCOVERY_PAGES=20
PROJECTX_DAEMON_GAS_BUDGET_MIST=200000000

# The run journal. REQUIRED for a live run, and unused by --dry-run.
#
# Every tick is recorded here, and this is also where the single-instance lock lives — without it
# two daemons could both harvest and both pay gas, and nothing would show what either of them did.
#
#   createdb projectx_daemon
#   psql -d projectx_daemon -f db/001_journal.sql
PROJECTX_DAEMON_DATABASE_URL=

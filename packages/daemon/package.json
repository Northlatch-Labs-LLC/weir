{
  "name": "@projectx-social/daemon",
  "version": "1.0.2",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "weir-harvest": "./dist/main.js",
    "weir-harvest-status": "./dist/status-main.js",
    "weir-harvest-journal": "./dist/journal-main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:chain": "vitest run --config vitest.chain.config.ts",
    "start": "tsx src/main.ts",
    "dry-run": "tsx src/main.ts --once --dry-run",
    "status": "tsx src/status-main.ts",
    "journal": "tsx src/journal-main.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@mysten/sui": "2.30.0",
    "@projectx-social/policy": "1.0.2",
    "@projectx-social/sdk": "1.0.2",
    "@projectx-social/signer": "1.0.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Northlatch-Labs-LLC/weir.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/Northlatch-Labs-LLC/weir/tree/main/packages/daemon#readme",
  "bugs": {
    "url": "https://github.com/Northlatch-Labs-LLC/weir/issues"
  }
}

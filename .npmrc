# Cross-references between the publishable packages name real version numbers rather than
# `workspace:*`, because npm cannot resolve that protocol from a registry. Without this line pnpm
# takes those numbers literally and goes to the registry for packages that are sitting in this
# repository — so a fresh clone fails to install with "No matching version found for
# @projectx-social/sdk@1.0.2" until that version happens to be published.
#
# This makes pnpm satisfy them from the workspace when the local version matches, and fall back to
# the registry when it does not. Both halves stay true: what is in git is what is on the registry,
# and the repository still installs.
link-workspace-packages=true
